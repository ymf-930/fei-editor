{
  "name": "fei-editor",
  "description": "基于vue的代码编辑器插件",
  "version": "0.0.3",
  "keywords": [
    "fei-editor",
    "vue3",
    "components",
    "editor",
    "code-editor",
    "ace-editor"
  ],
  "author": {
    "name": "yangmengfei",
    "email": "yangmengfei@example.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ymf-930/fei-editor.git"
  },
  "bugs": {
    "url": "https://github.com/ymf-930/fei-editor/issues"
  },
  "homepage": "https://ymf-930.github.io/fei-editor/",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/fei-editor.cjs.js",
  "module": "./lib/fei-editor.es.js",
  "types": "./lib/index.d.ts",
  "unpkg": "./lib/fei-editor.umd.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/fei-editor.es.js",
      "require": "./lib/fei-editor.cjs.js"
    }
  },
  "browserslist": [
    "defaults",
    "not ie < 11",
    "last 2 versions",
    "> 1%",
    "iOS 7",
    "last 3 iOS versions"
  ],
  "scripts": {
    "dev": "vitepress dev",
    "dev:old": "vite --config vite.config.dev.ts",
    "build:demo": "vitepress build",
    "build:demo:old": "rimraf docs && vite build --config vite.config.dev.ts",
    "build": "npm run clean-lib && npm run build:lib",
    "clean-lib": "rimraf lib",
    "build:lib": "vite build --config vite.config.ts",
    "preview": "vitepress preview",
    "preview:old": "vite preview --config vite.config.dev.ts",
    "preview:lib": "vite preview --config vite.config.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,md}\" \"examples/**/*.{js,ts,vue,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,md}\" \"examples/**/*.{js,ts,vue,json,css,md}\"",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "test": "echo \"No tests specified\" && exit 0",
    "prepare": "npm run build:lib",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build:lib",
    "postinstall": "echo \"Installation completed. You can now run: npm run dev\"",
    "clean": "rimraf lib docs node_modules/.vite",
    "reinstall": "npm run clean && npm install"
  },
  "dependencies": {
    "brace": "^0.11.1"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@eslint/js": "^9.35.0",
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/compiler-sfc": "^3.3.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "ant-design-vue": "^4.2.6",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-chain": "^1.3.0",
    "markdown-it-container": "^4.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "terser": "^5.44.0",
    "transliteration": "^2.3.5",
    "typescript": "^5.9.2",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0",
    "vitepress": "1.6.4",
    "vue": "3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "^4.2.5",
    "vue-tsc": "^3.0.6"
  }
}
