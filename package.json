{
  "name": "fei-editor",
  "description": "基于vue的代码编辑器插件",
  "version": "0.0.1",
  "keywords": [
    "fei-editor",
    "vue3",
    "components"
  ],
  "author": "yangmengfei",
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/fei-editor.common.js",
  "module": "src/components/editor/index.vue",
  "unpkg": "lib/fei-editor.js",
  "homepage": "https://ymf930.gitee.io/fei-editor/",
